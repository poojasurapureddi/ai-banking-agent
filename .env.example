# AI Banking Agent - Configuration Template
# Database settings
# For Docker setup, this defaults to PostgreSQL.
# For local Python execution without Docker, you can configure PostgreSQL or fallback to sqlite:///./banking.db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/banking_db
# Security
JWT_SECRET=change-this-to-a-long-random-secret-value
# AI LLM Provider configuration
# Add your Gemini API Key (recommended) or OpenAI API Key.
# If both keys are left blank, the backend agent runs in a local mock mode which
# executes all the requested operations via regex rule parser using the exact same backend tools.
GEMINI_API_KEY=
OPENAI_API_KEY=